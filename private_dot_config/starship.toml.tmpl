format = """
$time\
[│](fg:#a0a0a0)\
$username\
[@](bold fg:#373e50)\
$hostname\
[│](fg:#a0a0a0)\
$directory\
{{- if eq .chezmoi.hostname "SAB-C-000D0" "SAB-C-000CW" }}
[│](fg:#a0a0a0)\
$env_var\
{{- end }}
\n$character"""

[fill]
symbol = ' '

[username]
show_always = true
format = '[$user](bold fg:#373e50)'

[hostname]
ssh_only = false
format = '[$hostname](bold fg:#373e50)'

[directory]
format = "[$path](bold fg:#445f96)"
truncation_length = 5
truncation_symbol = "…/"

[git_branch]
symbol = ""
format = ' [\($symbol$branch](bold fg:#825c45)'

[git_status]
format = '[│](fg:#a0a0a0)[$all_status$ahead_behind](bold fg:#c87b2e)[\)](bold fg:#825c45)'

[time]
disabled = false
time_format = "%d.%m.%Y %R"
format = '[$time](bold fg:#1b1b1b)'
{{ if eq .chezmoi.hostname "SAB-C-000D0" "SAB-C-000CW" }}
[env_var.ROADIE]
variable = 'ROADIE_PROMPT_ICON'
format = '[$env_value](orange bold) '
{{- end }}
